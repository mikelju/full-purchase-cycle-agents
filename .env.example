# Copy to .env and fill in. Nothing here is needed for `npm run check`, which replays stored answers.

# Anthropic API key, scoped to a workspace. Needed for --mode live and --mode record.
ANTHROPIC_API_KEY=

# LangSmith tracing, datasets and experiments. Leave empty to send nothing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=
# Only for accounts in the EU region: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=

# Optional paths; defaults live under data/.
PURCHASE_CYCLE_DB=
PURCHASE_CYCLE_CHECKPOINTS=
